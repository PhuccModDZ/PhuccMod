-- // FOV CIRCLE
local FOVCircle = Drawing.new("Circle")
FOVCircle.Thickness = 2
FOVCircle.Color = Color3.fromRGB(255, 255, 255)
FOVCircle.Transparency = 0.5
FOVCircle.Visible = false

local function updateFOVCircle()
    if KRIZ.Whitelisted and AimSettings and AimSettings.ShowFOVCircle and AimSettings.Enabled then
        FOVCircle.Position = Vector2.new(Mouse.X, Mouse.Y + 36)
        FOVCircle.Radius = AimSettings.FOV
        FOVCircle.Visible = true
    else
        FOVCircle.Visible = false
    end
end

-- // UTILITY FUNCTIONS
local function isAlive(player)
    local character = player.Character
    if not character then return false end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return false end
    return true
end

local function getClosestPlayerToFOV()
    if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then return nil end
    
    local closestPlayer = nil
    local closestDistance = AimSettings.FOV
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and isAlive(player) then
            if AimSettings.TeamCheck and player.Team == LocalPlayer.Team then continue end
            
            local character = player.Character
            local targetPart = character:FindFirstChild(AimSettings.Part)
            if not targetPart then continue end
            
            local screenPos, onScreen = Camera:WorldToScreenPoint(targetPart.Position)
            if not onScreen then continue end
            
            local screenDist = Vector2.new(screenPos.X - Mouse.X, screenPos.Y - Mouse.Y).Magnitude
            
            if screenDist < closestDistance then
                if AimSettings.VisibilityCheck then
                    local raycastParams = RaycastParams.new()
                    raycastParams.FilterDescendantsInstances = {LocalPlayer.Character}
                    raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
                    
                    local raycastResult = workspace:Raycast(Camera.CFrame.Position, (targetPart.Position - Camera.CFrame.Position).Unit * 1000, raycastParams)
                    
                    if raycastResult and raycastResult.Instance:IsDescendantOf(character) then
                        closestPlayer = player
                        closestDistance = screenDist
                    end
                else
                    closestPlayer = player
                    closestDistance = screenDist
                end
            end
        end
    end
    
    return closestPlayer
end

local function aimAt(position)
    local targetCFrame = CFrame.new(Camera.CFrame.Position, position)
    local smoothness = AimSettings.Smoothness
    
    if smoothness > 1 then
        local currentCFrame = Camera.CFrame
        local smoothedCFrame = currentCFrame:Lerp(targetCFrame, 1 / smoothness)
        Camera.CFrame = smoothedCFrame
    else
        Camera.CFrame = targetCFrame
    end
end

-- // AIM LOOP
RunService.RenderStepped:Connect(function()
    updateFOVCircle()
    
    if not KRIZ.Whitelisted or not AimSettings or not AimSettings.Enabled then return end
    
    local target = getClosestPlayerToFOV()
    if not target then return end
    
    local character = target.Character
    local targetPart = character:FindFirstChild(AimSettings.Part)
    if not targetPart then return end
    
    local targetPosition = targetPart.Position
    
    if AimSettings.Prediction > 0 then
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if humanoid and humanoid.MoveDirection.Magnitude > 0 then
            local velocity = humanoid.MoveDirection * humanoid.WalkSpeed
            targetPosition = targetPosition + velocity * AimSettings.Prediction
        end
    end
    
    if AimSettings.SilentAim then
        -- Silent aim implementation (fires at target without moving camera)
        local oldCFrame = Camera.CFrame
        Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetPosition)
        task.wait()
        Camera.CFrame = oldCFrame
    else
        aimAt(targetPosition)
    end
end)

-- // ESP FUNCTIONS
function clearESP()
    for _, obj in pairs(KRIZ.ESPObjects) do
        if obj and obj.Remove then
            obj:Remove()
        end
    end
    KRIZ.ESPObjects = {}
end

local function createESP(player)
    if player == LocalPlayer then return end
    
    local espData = {
        Box = Drawing.new("Square"),
        Name = Drawing.new("Text"),
        HealthBar = Drawing.new("Line"),
        HealthText = Drawing.new("Text"),
        Distance = Drawing.new("Text"),
        Tracer = Drawing.new("Line"),
        HeadDot = Drawing.new("Circle"),
        Player = player
    }
    
    -- Configure ESP objects
    espData.Box.Thickness = 2
    espData.Box.Color = ESPSettings.Color
    espData.Box.Transparency = 0.7
    
    espData.Name.Color = Color3.fromRGB(255, 255, 255)
    espData.Name.Size = 13
    espData.Name.Center = true
    
    espData.HealthBar.Thickness = 2
    espData.HealthBar.Color = Color3.fromRGB(0, 255, 0)
    
    espData.Distance.Color = Color3.fromRGB(255, 255, 255)
    espData.Distance.Size = 12
    espData.Distance.Center = true
    
    espData.Tracer.Thickness = 1
    espData.Tracer.Color = ESPSettings.Color
    espData.Tracer.Transparency = 0.5
    
    espData.HeadDot.Radius = 5
    espData.HeadDot.Color = Color3.fromRGB(255, 255, 0)
    espData.HeadDot.Filled = true
    
    KRIZ.ESPObjects[player.UserId] = espData
end

local function updateESP()
    if not ESPSettings or not ESPSettings.Enabled then return end
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and isAlive(player) then
            if not KRIZ.ESPObjects[player.UserId] then
                createESP(player)
            end
            
            local espData = KRIZ.ESPObjects[player.UserId]
            local character = player.Character
            local humanoid = character:FindFirstChildOfClass("Humanoid")
            local head = character:FindFirstChild("Head")
            local rootPart = character:FindFirstChild("HumanoidRootPart")
            
            if not head or not rootPart then continue end
            
            local headPos, headOnScreen = Camera:WorldToScreenPoint(head.Position)
            local rootPos, rootOnScreen = Camera:WorldToScreenPoint(rootPart.Position)
            
            if not headOnScreen or not rootOnScreen then
                -- Hide ESP if not on screen
                espData.Box.Visible = false
                espData.Name.Visible = false
                espData.HealthBar.Visible = false
                espData.HealthText.Visible = false
                espData.Distance.Visible = false
                espData.Tracer.Visible = false
                espData.HeadDot.Visible = false
                continue
            end
            
            -- Calculate box dimensions
            local scale = 1000 / (Camera.CFrame.Position - rootPart.Position).Magnitude
            local boxHeight = 2 * scale
            local boxWidth = 1.5 * scale
            
            -- Update box
            if ESPSettings.Boxes then
                espData.Box.Visible = true
                espData.Box.Size = Vector2.new(boxWidth, boxHeight)
                espData.Box.Position = Vector2.new(rootPos.X - boxWidth / 2, rootPos.Y - boxHeight / 2)
                espData.Box.Color = ESPSettings.UseTeamColor and player.TeamColor.Color or ESPSettings.Color
            else
                espData.Box.Visible = false
            end
            
            -- Update name
            if ESPSettings.Names then
                espData.Name.Visible = true
                espData.Name.Text = player.Name
                espData.Name.Position = Vector2.new(rootPos.X, rootPos.Y - boxHeight / 2 - 15)
            else
                espData.Name.Visible = false
            end
            
            -- Update health bar
            if ESPSettings.Health and humanoid then
                local healthPercent = humanoid.Health / humanoid.MaxHealth
                espData.HealthBar.Visible = true
                espData.HealthBar.From = Vector2.new(rootPos.X - boxWidth / 2 - 5, rootPos.Y + boxHeight / 2)
                espData.HealthBar.To = Vector2.new(rootPos.X - boxWidth / 2 - 5, rootPos.Y + boxHeight / 2 - boxHeight * healthPercent)
                espData.HealthBar.Color = Color3.new(1 - healthPercent, healthPercent, 0)
            else
                espData.HealthBar.Visible = false
            end
            
            -- Update distance
            if ESPSettings.Distance then
                espData.Distance.Visible = true
                local distance = math.floor((Camera.CFrame.Position - rootPart.Position).Magnitude)
                espData.Distance.Text = distance .. "m"
                espData.Distance.Position = Vector2.new(rootPos.X, rootPos.Y + boxHeight / 2 + 5)
            else
                espData.Distance.Visible = false
            end
            
            -- Update tracer
            if ESPSettings.Tracers then
                espData.Tracer.Visible = true
                espData.Tracer.From = Vector2.new(Mouse.X, Mouse.Y + 36)
                espData.Tracer.To = Vector2.new(rootPos.X, rootPos.Y)
            else
                espData.Tracer.Visible = false
            end
            
            -- Update head dot
            if ESPSettings.HeadDot then
                espData.HeadDot.Visible = true
                espData.HeadDot.Position = Vector2.new(headPos.X, headPos.Y)
            else
                espData.HeadDot.Visible = false
            end
        end
    end
    
    -- Clean up dead players ESP
    for userId, espData in pairs(KRIZ.ESPObjects) do
        local player = espData.Player
        if not isAlive(player) or not player:IsDescendantOf(Players) then
            espData.Box:Remove()
            espData.Name:Remove()
            espData.HealthBar:Remove()
            espData.HealthText:Remove()
            espData.Distance:Remove()
            espData.Tracer:Remove()
            espData.HeadDot:Remove()
            KRIZ.ESPObjects[userId] = nil
        end
    end
end

